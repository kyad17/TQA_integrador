{
    "name": "integrador/centro-tqa",
    "type": "project",
    "description": "Centro independiente de pruebas del sistema de transporte",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.7",
        "inertiajs/inertia-laravel": "^3.0",
        "setasign/fpdf": "~1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.23",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
